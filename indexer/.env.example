# Per-IP rate limiting for the /api/v1 routes (GET /health is never limited).
# Defaults: 60 requests per 60000 ms window.
INDEXER_RATE_LIMIT_WINDOW_MS=60000
INDEXER_RATE_LIMIT_MAX=60
