datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Ship Prisma engines for both image architectures so the same generate
  // step works for linux/amd64 and linux/arm64 (#1049). Alpine uses musl with
  // OpenSSL 3, hence the musl-openssl-3.0.x targets (amd64 + arm64).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

model Mint {
  id        String   @id @default(uuid())
  to        String
  amount    String
  ledger    Int
  txHash    String   @unique
  createdAt DateTime @default(now())
}

model Transfer {
  id        String   @id @default(uuid())
  from      String
  to        String
  amount    String
  ledger    Int
  txHash    String   @unique
  createdAt DateTime @default(now())
}

model Burn {
  id        String   @id @default(uuid())
  from      String
  amount    String
  ledger    Int
  txHash    String   @unique
  createdAt DateTime @default(now())
}

/// Yield-vault and wrapper `deposit` events.
/// Yield vault data is `(caller, assets, shares)`. Wrapper data appends a
/// schema version that is not stored.
model VaultDeposit {
  id        String   @id @default(uuid())
  caller    String
  assets    String
  shares    String
  ledger    Int
  txHash    String   @unique
  createdAt DateTime @default(now())
}

/// Wrapper `wrap` and `unwrap` events.
/// `kind` is the topic. `amount` is the input and `resultAmount` is the output.
model WrapperUpdate {
  id           String   @id @default(uuid())
  kind         String
  caller       String
  amount       String
  resultAmount String
  ledger       Int
  txHash       String   @unique
  createdAt    DateTime @default(now())
}

/// Vesting `v_rel` events: tokens released to a beneficiary.
model VestingClaim {
  id          String   @id @default(uuid())
  beneficiary String
  amount      String
  ledger      Int
  txHash      String   @unique
  createdAt   DateTime @default(now())
}

/// Split `pyo_succ` events: a successful invoice payout.
model SplitDistribution {
  id         String   @id @default(uuid())
  invoiceId  String
  recipient  String
  amount     String
  ledger     Int
  txHash     String   @unique
  createdAt  DateTime @default(now())
}

/// Aggregate holder balances, maintained transactionally by the indexer as
/// mint, transfer, and burn events are persisted. A row exists only while the
/// holder's balance is non-zero.
model Holder {
  id        String   @id @default(uuid())
  address   String   @unique
  balance   String
  ledger    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Aggregate supply points, one per supply-changing event (mint or burn).
/// The `supply` value is the authoritative `new_supply` from the indexed
/// event payload.
model SupplyPoint {
  id        String   @id @default(uuid())
  timestamp DateTime
  supply    String
  ledger    Int
  txHash    String
  createdAt DateTime @default(now())
}

model LastIndexedLedger {
  id         Int     @id @default(1)
  ledger     Int
  hash       String?
  parentHash String?
}

model IndexedLedger {
  ledger     Int    @id
  hash       String @unique
  parentHash String
}

model Webhook {
  id        String   @id @default(uuid())
  url       String   @unique
  createdAt DateTime @default(now())
}
