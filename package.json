{
  "name": "bc-forge-workspace",
  "private": true,
  "workspaces": [
    "sdk",
    "react",
    "cli",
    "indexer"
  ],
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "docs:gen:sdk": "typedoc",
    "docs:gen:contracts": "cargo doc --workspace --exclude bc-forge-e2e-tests --no-deps && node scripts/copy-rustdoc.mjs",
    "docs:gen": "npm run docs:gen:sdk && npm run docs:gen:contracts",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:build": "npm run docs:gen && vitepress build docs"
  }
}
