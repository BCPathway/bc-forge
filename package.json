{
  "name": "bc-forge-workspace",
  "private": true,
  "workspaces": [
    "sdk",
    "react",
    "cli",
    "indexer"
  ],
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "docs:gen:sdk": "typedoc",
    "docs:gen:contracts": "cargo doc --workspace --exclude bc-forge-e2e-tests --no-deps && node scripts/copy-rustdoc.mjs",
    "docs:gen": "npm run docs:gen:sdk && npm run docs:gen:contracts",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "prepublish:validate": "node scripts/prepublish-validate.mjs",
    "release:notes:react": "node scripts/release-notes.mjs react",
    "release:notes:indexer": "node scripts/release-notes.mjs indexer",
    "test:tarball": "node scripts/test-tarball.mjs",
    "release:validate": "node scripts/prepublish-validate.mjs && node scripts/test-tarball.mjs",
    "verify:published": "node scripts/verify-published-react.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "axios": "1.20.0",
    "@stellar/stellar-sdk": {
      "axios": "1.20.0"
    }
  }
}
