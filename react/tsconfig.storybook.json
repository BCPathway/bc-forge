{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noEmit": true,
    // The base config pins `rootDir` to `src` so the library build and the
    // per-file ts-jest compile agree on the output layout. This config compiles
    // a wider tree — `.storybook`, `stories`, `visual` and the Playwright config
    // all sit outside `src` — so the root has to widen with it (TS6059).
    "rootDir": "."
  },
  "include": [".storybook", "stories", "visual", "playwright.visual.config.ts"]
}
